# Secret Garage nodes share to talk to each other. A single node still needs
# one: generate it with `openssl rand -hex 32`.
GARAGE_RPC_SECRET=<generate a secret>

# The key Garage creates on its first start. The Meet backend uses this pair as
# AWS_S3_ACCESS_KEY_ID and AWS_S3_SECRET_ACCESS_KEY. Garage refuses to start
# with an access key shorter than 8 characters or a secret key shorter than 16:
# `openssl rand -hex 12` and `openssl rand -hex 32` give 24 and 64.
GARAGE_ACCESS_KEY=<generate an access key>
GARAGE_SECRET_KEY=<generate a secret key>

# Name of the Meet stack's internal network: <meet project name>_internal.
# The default fits a Meet stack started from a directory named "meet".
MEET_INTERNAL_NETWORK=meet_internal
