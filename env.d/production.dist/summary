# The summary service and its Celery workers, from the AI Transcription guide.
# generate-secrets.sh fills every <...> value and your domain.

# Celery broker: the summary service's own Redis
CELERY_BROKER_URL=redis://redis-summary:6379/0
CELERY_RESULT_BACKEND=redis://redis-summary:6379/0

# Object storage: the Recording guide's Garage
AWS_S3_ENDPOINT_URL=http://garage:9000
AWS_S3_ACCESS_KEY_ID=<GARAGE_ACCESS_KEY>
AWS_S3_SECRET_ACCESS_KEY=<GARAGE_SECRET_KEY>
AWS_S3_REGION_NAME=garage
AWS_STORAGE_BUCKET_NAME=meet-media-storage
AWS_S3_SECURE_ACCESS=False

# The Meet backend allowed to submit tasks, with the two secrets it shares
AUTHORIZED_TENANTS='[{
  "id": "meet",
  "api_key": "<SUMMARY_SERVICE_API_TOKEN>",
  "webhook_url": "https://meet.example.com/api/v1.0/recordings/external-process-hook/",
  "webhook_api_key": "<SUMMARY_SERVICE_WEBHOOK_API_TOKEN>",
  "allowed_push_to_docs": true
}]'

# Your WhisperX API
WHISPERX_BASE_URL=http://whisperx:8000/v1
WHISPERX_ASR_MODEL=large-v3
WHISPERX_API_KEY=your-api-key

# Your LLM API
LLM_BASE_URL=https://your-llm-api.example.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini

# Your LaSuite Docs, where the transcripts go
IS_LASUITE_DOCS_INTEGRATION_ENABLED=True
LASUITE_DOCS_BASE_URL=https://docs.example.com
LASUITE_DOCS_SERVER_TO_SERVER_API_KEY=your-docs-api-key
